# SkillQuest deployment settings.
#   cp .env.example .env && chmod 600 .env
# NEVER commit .env (it is in .gitignore). Every value below is a placeholder, not a real secret.

# Public domain name that points to your server (DNS A/AAAA record). Used by Caddy and the Host allow-list.
SKILLQUEST_DOMAIN=quest.example.com

# E-mail for Let's Encrypt expiry notices.
ACME_EMAIL=admin@example.com

# Login for the whole app, as user:password (min. 12 characters; the app refuses to start with this placeholder).
# Generate a strong one:   python3 -c "import secrets; print('me:' + secrets.token_urlsafe(24))"
SKILLQUEST_BASIC_AUTH=CHANGE_ME_user:CHANGE_ME_generate_a_long_random_password

# Backups: one every BACKUP_INTERVAL_SECONDS (86400 = daily); keep the newest BACKUP_KEEP files.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP=14

# Optional hardening knobs (defaults shown):
# SKILLQUEST_AUTH_MAX_FAILURES=10
# SKILLQUEST_AUTH_LOCKOUT_SECONDS=300
