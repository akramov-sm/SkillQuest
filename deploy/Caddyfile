# Caddy obtains and renews the Let's Encrypt certificate automatically.
# Requirements: DNS for {$SKILLQUEST_DOMAIN} points here; ports 80 and 443 are open.
{
	email {$ACME_EMAIL}
}

{$SKILLQUEST_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	request_body {
		max_size 1MB
	}

	reverse_proxy app:8000 {
		# Host is passed through unchanged (the app checks it). X-Forwarded-For is *overwritten*
		# with the real peer address so the login lockout cannot be bypassed by a spoofed header.
		header_up X-Forwarded-For {remote_host}
	}
}
